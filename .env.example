# Generate real random values with: python3 scripts/setup_env.py
JWT_SECRET=replace-with-random-at-least-32-characters
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=replace-with-a-strong-password
POSTGRES_USER=oral
POSTGRES_DB=oral
POSTGRES_PASSWORD=replace-with-random-database-password
MINIO_ROOT_USER=oralstorage
MINIO_ROOT_PASSWORD=replace-with-random-storage-password
S3_BUCKET=oral-assessment
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Local source UI (npm run dev / npm run desktop). Switch in the UI; no restart needed.
ORAL_BACKEND_MODE=online
ORAL_LOCAL_BACKEND_URL=http://localhost:3000
ORAL_ONLINE_BACKEND_URL=https://oral-test.paperlens.uk
ORAL_CLIENT_PORT=3001
MINIO_CONSOLE_PORT=9001
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# AI for question generation, embeddings and grading text; does not choose STT.
AI_CONFIG_SOURCE=env
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_TIMEOUT=180
GEMINI_STT_MODEL=gemini-2.5-flash
# Used by AI_PROVIDER=local and full local audio reviews.
LOCAL_LLM_URL=http://host.docker.internal:11434
LOCAL_LLM_TIMEOUT=600
# 0 lets the inference engine choose compute threads; overlays force automatic mode.
LOCAL_LLM_CPU_THREADS=0
# Jenkins opt-in for a separate Oral-only Ollama; native Compose needs docker-compose.ollama.yml.
ORAL_OLLAMA_ENABLED=false
ORAL_OLLAMA_IMAGE=ollama/ollama:0.40.10
# Optional Ollama model for full local audio reviews, including exams published with another provider.
# Empty uses LLM_MODEL only when AI_PROVIDER=local in the base deployment.
# The Oral Ollama overlay defaults to qwen2.5:3b; Jenkins installs missing models in its own volume.
LOCAL_REVIEW_LLM_MODEL=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
CONFIDENCE_THRESHOLD=0.85
TOP_K=5
# Independent web STT default: local (desktop required), local_server, gemini, google.
# A speech policy saved in the admin UI overrides this initial default.
STT_PROVIDER=local
STT_MODEL=base
STT_LANGUAGE=vi
STT_CPU_THREADS=0
# One grading job at a time; local AI overlays do not set Docker CPU/RAM quotas.
WORKER_SERIAL=true
# Enable with docker compose -f docker-compose.yml -f docker-compose.gopt.yml up -d --build
GOPT_ENABLED=false
# Jenkins uses a prebuilt GOPT image when GOPT_ENABLED=true; build it before deploying.
ORAL_GOPT_IMAGE=oral-assessment-gopt:cpu
GOPT_URL=http://gopt:8000
GOPT_TIMEOUT=960
GOPT_JOB_TIMEOUT=900
GOPT_MAX_AUDIO_MB=24
GOPT_MAX_AUDIO_SECONDS=120
MAX_TEXTBOOK_MB=100
MAX_DOCUMENT_MB=20
# Google Cloud STT only: upload JSON in admin or configure a file below. Gemini uses API key.
# For Docker, use docker-compose.google.yml and an absolute host file path.
GOOGLE_STT_CREDENTIALS_FILE=
GOOGLE_STT_CREDENTIALS_HOST_FILE=
# Native development only; Compose overrides these settings.
DATABASE_URL=sqlite:///./.data/app.db
STORAGE_BACKEND=local
DATA_DIR=.data
REDIS_URL=

# Google OAuth login (Web application client; not the STT service account).
# Paste credentials, set GOOGLE_LOGIN_ENABLED=true, then recreate API/worker:
# docker compose up -d --no-deps --force-recreate api worker
# Redirect URI: PUBLIC_ORIGIN + /api/auth/google/callback
# OAuth settings saved on web override these initial values. AI follows AI_CONFIG_SOURCE.
PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
