{
  "name": "@oral/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check server-preload.cjs && node --check server-config.cjs && node --check server.js && node --check check-stt-bundle.cjs && node --check correction.cjs && node --check unload-guard.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "description": "OralAI desktop oral assessment client",
  "author": "AI Oral Assessment Platform",
  "license": "Apache-2.0",
  "build": {
    "appId": "edu.oralai.desktop",
    "productName": "OralAI",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server-config.cjs",
      "server-preload.cjs",
      "server.html",
      "server.css",
      "server.js",
      "package.json",
      "correction.cjs",
      "unload-guard.cjs"
    ],
    "extraResources": [
      {
        "from": "transcribe.py",
        "to": "python/transcribe.py"
      },
      {
        "from": "../../services/api/app/audio_processing.py",
        "to": "python/audio_processing.py"
      },
      {
        "from": "resources/stt",
        "to": "stt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "AI Oral Assessment Platform",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OralAI s\u1eed d\u1ee5ng microphone \u0111\u1ec3 ki\u1ec3m tra ti\u1ebfng \u1ed3n v\u00e0 ghi c\u00e2u tr\u1ea3 l\u1eddi.",
        "NSCameraUsageDescription": "OralAI s\u1eed d\u1ee5ng camera \u0111\u1ec3 ghi h\u00ecnh c\u00e2u tr\u1ea3 l\u1eddi v\u1ea5n \u0111\u00e1p."
      }
    },
    "executableName": "oralai",
    "beforePack": "./check-stt-bundle.cjs",
    "asarUnpack": [
      "node_modules/@node-llama-cpp/**/*",
      "node_modules/node-llama-cpp/bins/**/*"
    ]
  },
  "desktopName": "oralai",
  "homepage": "https://github.com/NCKH-LongT/AI-Oral-Assessment-Platform",
  "dependencies": {
    "node-llama-cpp": "3.21.1"
  }
}
